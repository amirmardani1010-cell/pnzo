{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pnzo",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b6b1d49a-c75f-4328-976c-6bb352b24644","database_name": "pnzodb" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6a16ec45cd0148a58d3fda7a7262d263" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
